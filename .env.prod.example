# ==============================================================================
# SabQuick Production Environment Configuration (.env.prod)
# Template for Ubuntu 24.04 LTS KVM VPS (Hostinger)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Networking
# ------------------------------------------------------------------------------
# Your registered domain pointing via A / AAAA DNS records to your Hostinger VPS IP
DOMAIN_NAME=sabquick.example.com

# Canonical URL for NextAuth callbacks and client links (MUST match DOMAIN_NAME with https://)
NEXTAUTH_URL=https://sabquick.example.com
NEXT_PUBLIC_APP_URL=https://sabquick.example.com

# ------------------------------------------------------------------------------
# 2. Security & NextAuth Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32

# Owner bootstrap. Required only to provision a new owner (or reset a lost
# passcode); an existing owner logs in with the hashed PIN in the database. The
# passcode must be at least 8 characters and must not be a repo default.
OWNER_PHONE=
OWNER_PASSCODE=
OWNER_NAME="Store Owner"
OWNER_EMAIL=

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=sabquick_prod_user
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=sabquick_prod_db

# ------------------------------------------------------------------------------
# 4. Redis 7 Password
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=replace_with_strong_redis_password

# ------------------------------------------------------------------------------
# 5. Geofence & Dark-Store Hub Coordinates
# ------------------------------------------------------------------------------
# Default: Ambikapur, Chhattisgarh (23.131617° N, 83.191015° E)
HUB_LATITUDE=23.131617
HUB_LONGITUDE=83.191015
GEOFENCE_RADIUS_KM=3.5

# ------------------------------------------------------------------------------
# 6. OAuth Providers (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. Payment & Dynamic UPI QR Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_UPI_ID="yourstore@upi"
NEXT_PUBLIC_STORE_UPI_NAME="SabQuick Retail"

# ------------------------------------------------------------------------------
# 8. Cashfree 0% Fee Payment Gateway (Primary)
# ------------------------------------------------------------------------------
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="PRODUCTION"
NEXT_PUBLIC_CASHFREE_ENV="production"
CASHFREE_API_VERSION="2026-01-01"

# Keep online payments off until the Cashfree sandbox E2E and the security
# release gate pass. Set to "true" only after that.
ONLINE_PAYMENTS_ENABLED="false"

# ------------------------------------------------------------------------------
# 9. SMS Gateway (Renflair / Fast2SMS / 2Factor)
# ------------------------------------------------------------------------------
RENFLAIR_API_KEY=""
FAST2SMS_API_KEY=""
SMS_GATEWAY_API_KEY=""
OTP_DELIVERY_MODE="sms"

# ------------------------------------------------------------------------------
# 10. Cloudflare R2 Off-Site Database Backup (S3-Compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="sabquick-backups"
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 11. Google Firebase Phone Authentication (10,000 Free SMS/Month)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

