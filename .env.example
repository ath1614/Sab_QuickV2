# Database Configuration
DATABASE_URL="postgresql://sabquick_admin:sabquick_local_dev@localhost:5432/sabquick_db?schema=public"

# Cache & Message Broker
REDIS_URL="redis://localhost:6379"

# Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Owner bootstrap. Required in production; never commit the real passcode.
OWNER_PHONE=""
OWNER_PASSCODE=""
OWNER_NAME="Store Owner"
OWNER_EMAIL=""

# Hyper-Local Dark Store Geofence (Backend & Public Client)
STORE_LATITUDE="23.131617"
STORE_LONGITUDE="83.191015"
STORE_MAX_RADIUS_KM="3.5"
NEXT_PUBLIC_STORE_LAT="23.131617"
NEXT_PUBLIC_STORE_LNG="83.191015"
NEXT_PUBLIC_STORE_MAX_RADIUS_KM="3.5"

# Payment & Dynamic UPI QR Configuration
NEXT_PUBLIC_STORE_UPI_ID="yourstore@upi"
NEXT_PUBLIC_STORE_UPI_NAME="SabQuick Retail"

# Cashfree Payment Gateway (the only online gateway)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="SANDBOX"
NEXT_PUBLIC_CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2026-01-01"

# Online payments are intentionally disabled until the sandbox end-to-end
# test and the security release gate pass. Set to "true" only after that.
ONLINE_PAYMENTS_ENABLED="false"

# SMS Gateway (Renflair / Fast2SMS / 2Factor)
RENFLAIR_API_KEY=""
FAST2SMS_API_KEY=""
SMS_GATEWAY_API_KEY=""
OTP_DELIVERY_MODE="auto" # "sms" for real SMS only, "display" for dev-only code display

# Cloudflare R2 Off-Site Database Backup (S3-Compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="sabquick-backups"
