# Database Configuration
DATABASE_URL="postgresql://sabquick_admin:sabquick_local_dev@localhost:5432/sabquick_db?schema=public"

# Cache & Message Broker
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_SECRET="local_development_secret_32_chars_minimum"
NEXTAUTH_URL="http://localhost:3000"

# Hyper-Local Dark Store Geofence (Backend & Public Client)
STORE_LATITUDE="28.6139"
STORE_LONGITUDE="77.2090"
STORE_MAX_RADIUS_KM="2.5"
NEXT_PUBLIC_STORE_LAT="28.6139"
NEXT_PUBLIC_STORE_LNG="77.2090"
NEXT_PUBLIC_STORE_MAX_RADIUS_KM="2.5"

# Payment & Dynamic UPI QR Configuration
NEXT_PUBLIC_STORE_UPI_ID="yourstore@upi"
NEXT_PUBLIC_STORE_UPI_NAME="SabQuick Retail"

# SMS Gateway (Optional for production OTP delivery)
SMS_GATEWAY_API_KEY=""

# Cloudflare R2 Off-Site Database Backup (S3-Compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="sabquick-backups"

